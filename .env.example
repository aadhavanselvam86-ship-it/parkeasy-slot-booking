# Copy to .env for local use. NEVER commit real values.
# PostgreSQL (e.g. Neon / Vercel Postgres) - FAQs, error codes, slots, bookings, support tickets
DATABASE_URL=
# MongoDB Atlas - chat logs and feedback
MONGODB_URI=
MONGODB_DB=parkeasy
# Optional: Claude API key for AI answers (falls back to built-in FAQ matcher if empty)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Optional: protects GET /api/tickets (admin view)
ADMIN_TOKEN=
PORT=3000
